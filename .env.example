# ── Telegram ──────────────────────────────────────────────
BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Quote when user sends only base ticker (e.g. sol)
DEFAULT_QUOTE=USDT

# ── CoinMarketCap (optional, for contract addresses) ─────
CMC_API_KEY=

# ── Exchange API keys (D/W status requires wallet-read) ──
BINANCE_API_KEY=
BINANCE_API_SECRET=
BYBIT_API_KEY=
BYBIT_API_SECRET=
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=
MEXC_API_KEY=
MEXC_API_SECRET=
BINGX_API_KEY=
BINGX_API_SECRET=
BITGET_API_KEY=
BITGET_API_SECRET=
BITGET_API_PASSPHRASE=
KUCOIN_API_KEY=
KUCOIN_API_SECRET=
KUCOIN_API_PASSPHRASE=
KRAKEN_API_KEY=
KRAKEN_API_SECRET=

# ── Performance tuning ───────────────────────────────────
# Asia VPS (Vultr Tokyo, etc.) — low RTT to CEX APIs:
#   TURBO_MODE=1
#   ASIA_VPS=1
#
# Non-Asia / high-latency VPS — use relaxed timeouts:
#   TURBO_MODE=0
#   HTTP_TIMEOUT=2.5
#   HTTP_CONNECT_TIMEOUT=1.0
#   FAST_WAIT_MS=800
TURBO_MODE=0
ASIA_VPS=0
HTTP_TIMEOUT=0.55
HTTP_CONNECT_TIMEOUT=0.28
FAST_WAIT_MS=320
FIRST_PAINT_MS=300

# ── Misc ─────────────────────────────────────────────────
LOG_LEVEL=INFO
REPORT_CACHE_TTL=75
REPORT_CACHE_STALE_TTL=120
FAST_CACHE_TTL=75
DW_CACHE_TTL=600
